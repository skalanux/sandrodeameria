# Copiá este archivo a .env y completá los valores.
# .env no se versiona y no se copia dentro de la imagen.

# ---------- Voz ----------
# fish = Fish Audio (voz clonada privada)
# demo = Edge TTS (voz de prueba, requiere uv/uvx instalado)
VOICE_PROVIDER=fish
FISH_API_KEY=
FISH_VOICE_ID=
FISH_MODEL=s2.1-pro-free
FISH_LANGUAGE=es-AR
FISH_API_BASE=https://api.fish.audio

# ---------- Servidor ----------
HOST=0.0.0.0
PORT=4173

# ---------- Producción / Traefik ----------
SERVER_HOST=avatar.example.com
# Generá el hash con:
#   htpasswd -nbB usuario 'tu-clave'
# En .env usá comillas simples para que los $ no se interpolen.
BASIC_AUTH_USERS='usuario:$2y$05$...'

# Etiqueta de la imagen. El deploy la pasa automáticamente.
# IMAGE_TAG=local
